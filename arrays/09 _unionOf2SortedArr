class Solution {
    public int[] unionArray(int[] nums1, int[] nums2) {
        int m= nums1.length;
        int n= nums2.length;
        int arr[]=new int[n+m];
        int k=0;
        int i=0;
        int j=0;
        while(i<m && j<n){
            if(nums1[i]<nums2[j]){
                if(k == 0 || arr[k-1] != nums1[i]){
                arr[k]=nums1[i];
                k++;}
                i++;
            }
            else if(nums1[i]>nums2[j]){
                if(k == 0 || arr[k-1] != nums2[j]){
                arr[k]=nums2[j];
                k++;}
                j++;
            }
            else{
                if(k == 0 || arr[k-1] != nums1[i]){
                arr[k]=nums1[i];
                k++;
                j++;}
                i++;
            }
        }
         while(i<m){
            if(k == 0 || arr[k-1] != nums1[i]){
            arr[k]=nums1[i];
            k++;}
            i++;
         }
         while(j<n){
            if(k == 0 || arr[k-1] != nums2[j]){
            arr[k]=nums2[j];
            k++;}
            j++;
         }
    
       int result[] = new int[k];
       for(int l=0; l<k; l++){
        result[l]=arr[l];
       }
       return result;    
    }
}
