class Solution {
    public int longestSubarray(int[] nums, int k) {
     int n= nums.length;
     int maxLen=0;
     int sum;
     
     for(int i=0; i<n;i++){
        sum=0;
        
        for(int j=i; j<n; j++){
         sum= sum + nums[j]; 
         
         if(sum==k){
            maxLen = Math.max(maxLen, j - i + 1);
                }
            
         }

        }
        return maxLen;
     }  
    }
